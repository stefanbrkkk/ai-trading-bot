# ─────────────────────────────────────────────────────────────────────────────
#  PROJECT AURELIUS — ENVIRONMENT
#
#  Every value below is OPTIONAL. With an empty .env the platform runs end to
#  end on its deterministic in-process engines: the seeded market simulator,
#  the deterministic XAI narrative engine and the deterministic NL→SQL
#  compiler. Drop keys in when you are ready to switch a subsystem to live.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM PROVIDERS ───────────────────────────────────────────────────────
# Leave blank to use the built-in deterministic engines (no network, no cost).
# Set exactly one provider key to activate live inference; AURELIUS_LLM_PROVIDER
# picks which one is used when several are present.
#   deterministic | anthropic | openai | deepseek
AURELIUS_LLM_PROVIDER=deterministic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# DeepSeek R1 (ThinkJSON structured-output path — MASTER spec §2.3)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── MARKET DATA ──────────────────────────────────────────────────────────────
# Blank => deterministic seeded simulator (full order book, options chain, bars).
#   simulator | alpaca | polygon | finnhub
AURELIUS_MARKET_PROVIDER=simulator

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── BROKER EXECUTION ─────────────────────────────────────────────────────────
# Blank => internal paper broker (deterministic fills against simulated NBBO).
#   paper | alpaca_paper | alpaca_live | ibkr
AURELIUS_BROKER=paper

IBKR_GATEWAY_URL=
IBKR_ACCOUNT_ID=

# ── PERSISTENCE ──────────────────────────────────────────────────────────────
# Blank DATABASE_URL => embedded SQLite bitemporal ledger under AURELIUS_DATA_DIR.
# Set a Neon/Postgres URL to run the same append-only DDL on Postgres.
DATABASE_URL=
AURELIUS_DATA_DIR=.data

# ── BILLING ──────────────────────────────────────────────────────────────────
# Blank => simulated checkout (no network). Real keys switch to Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
AURELIUS_PRICE_USD_MONTH=200

# ── PLATFORM ─────────────────────────────────────────────────────────────────
# 32+ char secret used to sign session cookies. A deterministic dev value is
# derived automatically when this is blank.
AURELIUS_SESSION_SECRET=
# Deterministic RNG seed for the market simulator; keeps every run reproducible.
AURELIUS_SEED=20240117
# Admin bootstrap: the first user with this email is granted the admin role
# (kill-switch + telemetry console).
AURELIUS_ADMIN_EMAIL=admin@aurelius.local
