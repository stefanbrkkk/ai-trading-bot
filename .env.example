# ─────────────────────────────────────────────────────────────────────────────
#  PROJECT AURELIUS — ENVIRONMENT
#
#  Every value below is OPTIONAL. With an empty .env the platform runs end to
#  end on its deterministic in-process engines: the seeded market simulator,
#  the deterministic XAI narrative engine and the deterministic NL→SQL
#  compiler. Drop keys in when you are ready to switch a subsystem to live.
#
#  Every variable in this file is read by the code. Nothing here is aspirational
#  — a knob that is documented but unread is worse than an undocumented one,
#  because setting it produces a silent fallback that looks like a working
#  configuration. If you need something that is not listed, it is not wired yet.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM PROVIDERS ───────────────────────────────────────────────────────
# Leave blank to use the built-in deterministic engines (no network, no cost).
# Set a provider's key to activate live inference; AURELIUS_LLM_PROVIDER picks
# which one is used when several are present. A named provider whose key is
# missing degrades to the deterministic engine and says so on /transparency.
#   deterministic | anthropic | openai | deepseek
AURELIUS_LLM_PROVIDER=deterministic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# DeepSeek R1 (ThinkJSON structured-output path — MASTER spec §2.3)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── MARKET DATA ──────────────────────────────────────────────────────────────
# Blank => deterministic seeded simulator (full order book, options chain, bars).
# A live provider serves what it can and falls back to the simulator for the
# rest (an L10 book is not on a free tier), so the feature vector stays complete.
#   simulator | alpaca | polygon
AURELIUS_MARKET_PROVIDER=simulator

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

POLYGON_API_KEY=

# ── BROKER EXECUTION ─────────────────────────────────────────────────────────
# Blank => internal paper broker (deterministic fills against simulated NBBO).
#   paper | alpaca
# `alpaca` with either credential missing logs the downgrade and routes to paper;
# /admin reports which adapter is live and why.
AURELIUS_BROKER=paper

# Alpaca's venue. Defaults to the paper host; this is the ONLY switch between the
# sandbox and the live venue, and the platform reports the mode it inferred from
# the host on the admin panel.
#   https://paper-api.alpaca.markets  (default)
#   https://api.alpaca.markets        (live — real money)
ALPACA_BASE_URL=

# ── PERSISTENCE ──────────────────────────────────────────────────────────────
# Blank DATABASE_URL => embedded SQLite bitemporal ledger under AURELIUS_DATA_DIR.
# Set a Neon/Postgres URL to run the same append-only DDL on Postgres (requires
# registering a Postgres driver factory — see src/lib/db/client.ts).
DATABASE_URL=
AURELIUS_DATA_DIR=.data

# ── PLATFORM ─────────────────────────────────────────────────────────────────
# 32+ char secret used to sign session cookies. A deterministic dev value is
# derived automatically when this is blank.
AURELIUS_SESSION_SECRET=
# Deterministic RNG seed for the market simulator; keeps every run reproducible.
AURELIUS_SEED=20240117
# Admin bootstrap: the first user with this email is granted the admin role
# (kill switch, risk telemetry, entitlements).
AURELIUS_ADMIN_EMAIL=admin@aurelius.local
# Published monthly subscription price, in USD. Displayed on the entitlement
# surfaces and recorded against a subscription the admin activates.
AURELIUS_PRICE_USD_MONTH=200
# Pins the evaluation instant (epoch ms or an ISO timestamp) for the seed and for
# a backtest run, so a published result can be reproduced exactly months later.
# Blank => the last completed session close, which is what keeps the published
# list, the screener and every symbol page carrying the same number all day.
AURELIUS_NOW=

# ── DEPLOYMENT ───────────────────────────────────────────────────────────────
# `npm run build` trains an ensemble when the deployment has none, because a
# fresh clone has no `.data/` and five routes need one. Set to 1 to skip it —
# the platform still runs and those routes say what to run instead of failing.
AURELIUS_SKIP_SEED=
# The server sweeps the universe once at boot so the first request of the day
# does not pay for it. Set to 1 to skip; the sweep then happens on first use.
AURELIUS_SKIP_WARMUP=
